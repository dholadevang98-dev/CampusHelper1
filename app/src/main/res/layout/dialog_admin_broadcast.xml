<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_chip_status" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/icon_bg_alerts">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Emergency Broadcast"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/accent_coral" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Campus Broadcast Hub"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Push Instant Alerts to 140+ Campus Users"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnBroadcastClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider_color" />

        <!-- Broadcast Status Switch Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Broadcast Banner Active"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="Show banner on student home feed"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBroadcastActive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:useMaterialThemeColors="true" />
        </LinearLayout>

        <!-- Priority Chips -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-bold"
            android:text="Alert Priority Tier"
            android:textColor="@color/splash_accent_glow"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipPriorityUrgent"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/chip_rose_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="🚨 Urgent"
                android:textColor="@color/accent_coral"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipPriorityAcademic"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/chip_amber_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="📢 Academic"
                android:textColor="@color/accent_amber"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/chipPriorityInfo"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/chip_cyan_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-bold"
                android:gravity="center"
                android:text="ℹ️ General"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Broadcast Title Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBroadcastTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Broadcast Title / Subject"
            android:textColorHint="@color/input_hint"
            app:boxBackgroundColor="@color/input_bg"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/input_stroke_focus"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="@color/splash_accent_glow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBroadcastTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:inputType="textCapSentences"
                android:padding="14dp"
                android:textColor="@color/splash_text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Broadcast Message Body Input -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBroadcastBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Announcement Details &amp; Instructions"
            android:textColorHint="@color/input_hint"
            app:boxBackgroundColor="@color/input_bg"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/input_stroke_focus"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="@color/splash_accent_glow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etBroadcastBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:padding="14dp"
                android:textColor="@color/splash_text_primary"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Quick Templates -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-bold"
            android:text="⚡ Quick Presets"
            android:textColor="@color/splash_accent_glow"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/presetExamSchedule"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/glass_card_bg_elevated"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="📝 GTU Exam Schedule"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/presetWeatherAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/glass_card_bg_elevated"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="🌧️ Heavy Rain Holiday"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/presetTechFest"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/glass_card_bg_elevated"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="🚀 Annual TechFest 2026"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublishBroadcast"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.02"
            android:text="🚨 Dispatch Live Campus Broadcast"
            android:textAllCaps="false"
            android:textColor="@color/splash_text_primary"
            android:textSize="14sp"
            app:backgroundTint="@color/accent_coral"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
