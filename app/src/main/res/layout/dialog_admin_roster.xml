<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_chip_status" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/icon_bg_admin">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="GTU Roster"
                    android:src="@drawable/ic_check"
                    app:tint="@color/accent_cyan" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="GTU Master Roster"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Government Polytechnic, Rajkot (Code 620)"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnRosterClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider_color" />

        <!-- Search Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check"
                app:tint="@color/text_muted" />

            <EditText
                android:id="@+id/etSearchRoster"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif-medium"
                android:hint="Search by name or enrollment number..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/splash_text_primary"
                android:textColorHint="@color/input_hint"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/btnClearRosterSearch"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Department Filter Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerBranchChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipBranchAll"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/splash_accent_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="All (116)"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipBranchIT"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/glass_card_bg_elevated"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="IT (16)"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipBranchCE"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/glass_card_bg_elevated"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Computer (07)"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipBranchME"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/glass_card_bg_elevated"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Mechanical (19)"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipBranchCivil"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/glass_card_bg_elevated"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Civil (06)"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipBranchEE"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="@color/glass_card_bg_elevated"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Electrical (09)"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Count Summary -->
        <TextView
            android:id="@+id/tvRosterCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-bold"
            android:text="Showing 116 Verified Students"
            android:textColor="@color/splash_accent_glow"
            android:textSize="12sp" />

        <!-- Student List Container -->
        <LinearLayout
            android:id="@+id/containerRosterList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExportRoster"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.02"
            android:text="📥 Export Master Roster (CSV / Clipboard)"
            android:textAllCaps="false"
            android:textColor="@color/splash_text_primary"
            android:textSize="14sp"
            app:backgroundTint="@color/accent_cyan"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
