<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_chip_status" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/icon_bg_helpdesk">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Lost and Found"
                    android:src="@drawable/ic_lost_found"
                    app:tint="@color/accent_rose" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLostFoundFormTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Post / Edit Lost &amp; Found Item"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Fill in item details to log into student portal"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnLostFoundFormClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="@color/divider_color" />

        <!-- Item Title -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Item Name &amp; Model (e.g. Boat Airdopes Case, Calculator)"
            android:textColorHint="@color/input_hint"
            app:boxBackgroundColor="@color/input_bg"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/input_stroke_focus"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="@color/splash_accent_glow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etItemTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:padding="14dp"
                android:textColor="@color/splash_text_primary"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Location Found/Lost -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilItemLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Found / Lost Location (e.g. Library 2nd Floor, IT Lab 302)"
            android:textColorHint="@color/input_hint"
            app:boxBackgroundColor="@color/input_bg"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/input_stroke_focus"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="@color/splash_accent_glow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etItemLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:padding="14dp"
                android:textColor="@color/splash_text_primary"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Finder / Contact Info -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilItemContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Finder Info / Claim Desk (e.g. Deposited at Security Cabin)"
            android:textColorHint="@color/input_hint"
            app:boxBackgroundColor="@color/input_bg"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/input_stroke_focus"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="@color/splash_accent_glow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etItemContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:padding="14dp"
                android:textColor="@color/splash_text_primary"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Status Tag -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilItemStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Status Tag (e.g. FOUND ITEM, CLAIMED, LOST)"
            android:textColorHint="@color/input_hint"
            app:boxBackgroundColor="@color/input_bg"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/input_stroke_focus"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="@color/splash_accent_glow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etItemStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:padding="14dp"
                android:text="FOUND ITEM"
                android:textColor="@color/splash_text_primary"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveLostFound"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.02"
            android:text="💾 Save Item to Lost &amp; Found Portal"
            android:textAllCaps="false"
            android:textColor="@color/splash_text_primary"
            android:textSize="14sp"
            app:backgroundTint="@color/accent_rose"
            app:cornerRadius="12dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
