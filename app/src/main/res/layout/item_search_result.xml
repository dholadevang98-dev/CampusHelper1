<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/itemSearchContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- Category Icon -->
    <FrameLayout
        android:id="@+id/ivSearchIconBg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_badge_pill">

        <ImageView
            android:id="@+id/ivSearchIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Category Icon"
            android:src="@drawable/ic_search"
            app:tint="@color/splash_accent_primary" />
    </FrameLayout>

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSearchItemTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:text="Item Title"
                android:textColor="@color/splash_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvSearchItemTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_pill"
                android:fontFamily="sans-serif-bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="TAG"
                android:textColor="@color/splash_accent_glow"
                android:textSize="9sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSearchItemSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="Subtitle and details"
            android:textColor="@color/splash_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:contentDescription="Open"
        android:src="@drawable/ic_arrow_forward"
        app:tint="@color/text_muted" />

</LinearLayout>
