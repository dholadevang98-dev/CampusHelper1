<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_chip_status" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_badge_pill"
                android:backgroundTint="@color/icon_bg_admin">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="Admin Settings"
                    android:src="@drawable/ic_admin"
                    app:tint="@color/accent_teal" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:text="Admin Security &amp; Diagnostics"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="System Diagnostics &amp; Master Credentials"
                    android:textColor="@color/splash_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnSettingsClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Close"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_muted" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider_color" />

        <!-- System Health Overview Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/input_bg"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/splash_card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Cloud &amp; Security Status"
                    android:textColor="@color/splash_accent_glow"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSystemHealthInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:lineSpacingExtra="3dp"
                    android:text="• Firebase Authentication: [CONNECTED 🟢]\n• Firestore Database: [SYNCED 100%]\n• GTU Master Records: 116 Verified\n• Security Policy: GP Rajkot Locked"
                    android:textColor="@color/splash_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Change PIN Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-bold"
            android:text="Update Master Admin PIN"
            android:textColor="@color/splash_text_primary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="Change the 6-digit passcode for central administration access."
            android:textColor="@color/splash_text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCurrentPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Current PIN"
            android:textColorHint="@color/input_hint"
            app:boxBackgroundColor="@color/input_bg"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/input_stroke_focus"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="@color/splash_accent_glow"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/text_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCurrentPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:padding="12dp"
                android:textColor="@color/splash_text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilNewPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="New 6-Digit PIN"
            android:textColorHint="@color/input_hint"
            app:boxBackgroundColor="@color/input_bg"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/input_stroke_focus"
            app:boxStrokeWidth="1dp"
            app:hintTextColor="@color/splash_accent_glow"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/text_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNewPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:padding="12dp"
                android:textColor="@color/splash_text_primary"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdatePin"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.02"
            android:text="🔐 Update Master PIN"
            android:textAllCaps="false"
            android:textColor="@color/splash_text_primary"
            android:textSize="13sp"
            app:backgroundTint="@color/accent_teal"
            app:cornerRadius="12dp" />

        <!-- Lock Admin Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLockAdmin"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-bold"
            android:letterSpacing="0.02"
            android:text="🔒 Lock &amp; Switch to Student View"
            android:textAllCaps="false"
            android:textColor="@color/accent_coral"
            android:textSize="13sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/accent_coral" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
