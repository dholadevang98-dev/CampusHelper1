<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Top Glow -->
    <View
        android:id="@+id/topGlow"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-90dp"
        android:background="@drawable/bg_glow_circle"
        android:alpha="0.28"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom Glow -->
    <View
        android:id="@+id/bottomGlow"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginStart="-80dp"
        android:layout_marginBottom="-80dp"
        android:background="@drawable/bg_glow_circle_bottom"
        android:alpha="0.22"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp">

            <FrameLayout
                android:id="@+id/logoContainer"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_logo_container"
                android:elevation="8dp">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_campus_logo" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.01"
                android:text="Create Account"
                android:textColor="@color/splash_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"
                android:text="Register with your institutional details"
                android:textColor="@color/splash_text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSignUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/splash_card_bg"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp"
                app:strokeColor="@color/splash_card_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="24dp">

                    <!-- Full Name -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilName"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name"
                        android:textColorHint="@color/input_hint"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/selector_input_stroke"
                        app:hintTextColor="@color/selector_input_hint"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/selector_input_icon">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:inputType="textPersonName|textCapWords"
                            android:paddingVertical="14dp"
                            android:textColor="@color/splash_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>


                    <!-- Email Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSignUpEmail"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Email Address"
                        android:textColorHint="@color/input_hint"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/selector_input_stroke"
                        app:hintTextColor="@color/selector_input_hint"
                        app:startIconDrawable="@drawable/ic_mail"
                        app:startIconTint="@color/selector_input_icon">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSignUpEmail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:inputType="textEmailAddress"
                            android:paddingVertical="14dp"
                            android:textColor="@color/splash_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSignUpPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="Create Password"
                        android:textColorHint="@color/input_hint"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="@color/selector_input_stroke"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/splash_text_secondary"
                        app:hintTextColor="@color/selector_input_hint"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/selector_input_icon">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSignUpPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif"
                            android:inputType="textPassword"
                            android:paddingVertical="14dp"
                            android:textColor="@color/splash_text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Sign Up Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSignUp"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="22dp"
                        android:fontFamily="sans-serif-bold"
                        android:letterSpacing="0.03"
                        android:text="Create Student Account"
                        android:textAllCaps="false"
                        android:textColor="@color/splash_text_primary"
                        android:textSize="16sp"
                        app:backgroundTint="@color/splash_accent_primary"
                        app:cornerRadius="14dp"
                        app:elevation="4dp"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:iconPadding="8dp"
                        app:iconTint="@color/splash_text_primary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Login Link -->
            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif"
                android:padding="8dp"
                android:text="Already have an account? Login"
                android:textColor="@color/splash_text_secondary"
                android:textSize="14sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>