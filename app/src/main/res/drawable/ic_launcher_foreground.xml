<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="6"
        android:translateY="6">

        <!-- Ambient Glow Aura behind logo -->
        <path
            android:pathData="M48,16 C64,16 78,30 78,48 C78,66 64,80 48,80 C32,80 18,66 18,48 C18,30 32,16 48,16 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="48"
                    android:centerY="48"
                    android:gradientRadius="36"
                    android:type="radial">
                    <item android:color="#356366F1" android:offset="0.0" />
                    <item android:color="#15A855F7" android:offset="0.6" />
                    <item android:color="#00000000" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Bottom Open Book / Wings (Left Page) -->
        <path
            android:pathData="M48,68 L24,56 C24,56 22,66 34,71 L48,77 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="24"
                    android:startY="56"
                    android:endX="48"
                    android:endY="77"
                    android:type="linear">
                    <item android:color="#6366F1" android:offset="0.0" />
                    <item android:color="#4F46E5" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Bottom Open Book / Wings (Right Page) -->
        <path
            android:pathData="M48,68 L72,56 C72,56 74,66 62,71 L48,77 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="72"
                    android:startY="56"
                    android:endX="48"
                    android:endY="77"
                    android:type="linear">
                    <item android:color="#A855F7" android:offset="0.0" />
                    <item android:color="#7C3AED" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner Book Layer / Elevation (Left Wing) -->
        <path
            android:pathData="M48,60 L28,49 C28,49 26,57 38,62 L48,66 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="28"
                    android:startY="49"
                    android:endX="48"
                    android:endY="66"
                    android:type="linear">
                    <item android:color="#818CF8" android:offset="0.0" />
                    <item android:color="#6366F1" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner Book Layer / Elevation (Right Wing) -->
        <path
            android:pathData="M48,60 L68,49 C68,49 70,57 58,62 L48,66 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="68"
                    android:startY="49"
                    android:endX="48"
                    android:endY="66"
                    android:type="linear">
                    <item android:color="#C084FC" android:offset="0.0" />
                    <item android:color="#9333EA" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Cap Base / Skullcap arc -->
        <path
            android:pathData="M34,35 C34,44 40,51 48,51 C56,51 62,44 62,35 L48,42 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="34"
                    android:startY="35"
                    android:endX="62"
                    android:endY="51"
                    android:type="linear">
                    <item android:color="#4338CA" android:offset="0.0" />
                    <item android:color="#6D28D9" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Graduation Cap Top (Diamond Rhombus) -->
        <path
            android:pathData="M48,17 L79,30 L48,43 L17,30 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="17"
                    android:startY="17"
                    android:endX="79"
                    android:endY="43"
                    android:type="linear">
                    <item android:color="#38BDF8" android:offset="0.0" />
                    <item android:color="#6366F1" android:offset="0.45" />
                    <item android:color="#A855F7" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Cap Diamond Bevel / Highlight Line -->
        <path
            android:pathData="M48,17 L79,30 L48,43"
            android:strokeWidth="1.2"
            android:strokeColor="#60FFFFFF"
            android:fillColor="#00000000" />

        <!-- Tassel Ribbon & Drop -->
        <path
            android:pathData="M48,30 L73,36 L72,48"
            android:strokeWidth="1.8"
            android:strokeColor="#38BDF8"
            android:strokeLineCap="round"
            android:fillColor="#00000000" />

        <!-- Tassel Tip -->
        <path
            android:pathData="M70,48 L74,48 L73,53 L71,53 Z"
            android:fillColor="#38BDF8" />

        <!-- Knowledge Spark / Central Star (Outer Glow) -->
        <path
            android:pathData="M48,34 C48,38 45,41 41,41 C45,41 48,44 48,48 C48,44 51,41 55,41 C51,41 48,38 48,34 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="41"
                    android:startY="34"
                    android:endX="55"
                    android:endY="48"
                    android:type="linear">
                    <item android:color="#FFFFFF" android:offset="0.0" />
                    <item android:color="#E0E7FF" android:offset="0.5" />
                    <item android:color="#818CF8" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Small Spark Satellite Dots -->
        <path
            android:pathData="M48,30 A1.2,1.2 0 1,0 48,32.4 A1.2,1.2 0 1,0 48,30 Z
                              M48,49.6 A1.2,1.2 0 1,0 48,52 A1.2,1.2 0 1,0 48,49.6 Z
                              M38,41 A1.2,1.2 0 1,0 38,43.4 A1.2,1.2 0 1,0 38,41 Z
                              M58,41 A1.2,1.2 0 1,0 58,43.4 A1.2,1.2 0 1,0 58,41 Z"
            android:fillColor="#E0E7FF" />

    </group>

</vector>